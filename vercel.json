<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>🤠 Howdy Texas!</title>
  <meta name="description" content="Volg onze Texas roadtrip live, stem mee en win punten!" />

  <!-- PWA -->
  <meta name="theme-color" content="#2a0d00" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Howdy Texas" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/icon-192.png" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; background: #1a0a00; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #F5E6C8; }

    /* ── ONBOARDING ── */
    #onboard {
      position: fixed; inset: 0; background: #1a0a00;
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; padding: 28px; z-index: 200;
    }
    .ob-hat { font-size: 52px; margin-bottom: 14px; }
    .ob-title { font-size: 24px; font-weight: 700; color: #F5E6C8; text-align: center; }
    .ob-sub { font-size: 13px; color: #C8922A; margin-top: 8px; text-align: center; line-height: 1.7; margin-bottom: 28px; }
    .ob-langs { display: flex; gap: 10px; width: 100%; max-width: 400px; margin-bottom: 20px; }
    .ob-lang-btn {
      flex: 1; padding: 12px;
      background: #6B3A1F; border: 2px solid #9a5c30;
      border-radius: 10px; color: #d4b896;
      font-size: 14px; font-weight: 500; cursor: pointer;
      transition: all 0.15s;
    }
    .ob-lang-btn.active { background: #8B4513; border-color: #C8922A; color: #F5E6C8; font-weight: 700; }
    .ob-label { font-size: 11px; color: #C8922A; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 6px; width: 100%; max-width: 400px; }
    .ob-input {
      width: 100%; max-width: 400px; padding: 13px 16px; font-size: 16px;
      background: #2a1200; border: 2px solid #C8922A;
      border-radius: 12px; color: #F5E6C8; margin-bottom: 14px;
      text-align: center; outline: none;
    }
    .ob-input::placeholder { color: #5a3010; }
    .ob-btn {
      width: 100%; max-width: 400px; padding: 15px;
      background: #C8922A; color: #1a0a00;
      border: none; border-radius: 12px;
      font-size: 16px; font-weight: 700; cursor: pointer;
      transition: background 0.15s;
    }
    .ob-btn:hover { background: #e0a030; }

    /* ── MAIN APP ── */
    #main-app { display: none; flex-direction: column; height: 100vh; }

    .topbar {
      background: #2a0d00; border-bottom: 2px solid #C8922A;
      padding: 10px 14px; display: flex; align-items: center; gap: 8px;
      flex-shrink: 0;
    }
    .topbar-title { flex: 1; }
    .topbar-main { font-size: 16px; font-weight: 600; color: #F5E6C8; }
    .topbar-sub { font-size: 11px; color: #C8922A; margin-top: 1px; }
    .user-pill {
      background: #3a1800; border: 1.5px solid #C8922A;
      border-radius: 99px; padding: 4px 10px;
      font-size: 12px; color: #C8922A;
      display: flex; align-items: center; gap: 5px;
    }
    .lang-toggle {
      display: flex; background: #1a0a00;
      border-radius: 99px; border: 1.5px solid #C8922A;
      overflow: hidden; margin-left: 6px;
    }
    .lang-btn {
      padding: 4px 10px; font-size: 11px; font-weight: 600;
      color: #C8922A; background: transparent; border: none; cursor: pointer;
      transition: all 0.15s;
    }
    .lang-btn.active { background: #C8922A; color: #1a0a00; }

    .tabs {
      background: #220e00; display: flex;
      border-bottom: 1px solid #3a1800; flex-shrink: 0;
    }
    .tab {
      flex: 1; padding: 9px 2px; text-align: center;
      font-size: 10px; color: #6a4020; cursor: pointer;
      border-bottom: 2px solid transparent; transition: all 0.15s;
    }
    .tab.active { color: #F5E6C8; border-bottom: 2px solid #C8922A; }
    .tab-icon { font-size: 17px; margin-bottom: 2px; }

    .tab-content { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
    .section { display: none; padding: 12px; }
    .section.active { display: block; }

    /* ── CARDS ── */
    .card {
      background: #2a1200; border: 0.5px solid #5a3010;
      border-radius: 12px; padding: 14px; margin-bottom: 10px;
    }
    .card-title {
      font-size: 12px; font-weight: 600; color: #C8922A;
      margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.8px;
      display: flex; align-items: center; gap: 7px;
    }
    .badge-live {
      font-size: 10px; padding: 2px 8px; border-radius: 99px;
      background: #1a4a2a; color: #5dba7d; border: 1px solid #5dba7d;
      margin-left: auto;
    }

    /* ── BUTTONS ── */
    .btn-gold {
      width: 100%; padding: 13px; background: #C8922A; color: #1a0a00;
      border: none; border-radius: 10px; font-size: 14px; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: background 0.15s;
    }
    .btn-gold:hover { background: #e0a030; }
    .btn-add {
      width: 100%; padding: 12px; background: #6B3A1F;
      border: 2px solid #C8922A; border-radius: 10px;
      color: #F5E6C8; font-size: 13px; font-weight: 600; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: background 0.15s;
    }
    .btn-add:hover { background: #7a4525; }
    .btn-sm-gold {
      padding: 9px 16px; background: #C8922A; color: #1a0a00;
      border: none; border-radius: 8px; font-size: 13px; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; gap: 6px;
      transition: background 0.15s; white-space: nowrap;
    }
    .btn-sm-gold:hover { background: #e0a030; }
    .btn-ghost {
      padding: 9px 16px; background: #6B3A1F; color: #F5E6C8;
      border: 1.5px solid #9a5c30; border-radius: 8px;
      font-size: 13px; cursor: pointer;
      display: flex; align-items: center; gap: 6px;
      transition: background 0.15s;
    }
    .btn-ghost:hover { background: #7a4525; }

    /* ── FORMS ── */
    .form-section { background: #2a1200; border: 2px solid #C8922A; border-radius: 12px; padding: 14px; margin-bottom: 12px; }
    .fl { font-size: 11px; color: #C8922A; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 5px; }
    .wi {
      width: 100%; padding: 9px 11px; font-size: 13px;
      background: #1a0a00; border: 1.5px solid #5a3010;
      border-radius: 8px; color: #F5E6C8; margin-bottom: 8px; outline: none;
    }
    .wi:focus { border-color: #C8922A; }
    .wi::placeholder { color: #5a3010; }
    textarea.wi { resize: none; }
    .btn-row { display: flex; gap: 8px; margin-top: 4px; }
    .option-row { display: flex; gap: 6px; margin-bottom: 6px; }
    .option-row .wi { margin-bottom: 0; flex: 1; }
    .remove-opt {
      background: #6B3A1F; border: 1.5px solid #9a5c30; color: #F5E6C8;
      cursor: pointer; font-size: 14px; padding: 0 10px;
      border-radius: 8px; transition: background 0.15s;
    }
    .remove-opt:hover { background: #7a4525; }

    /* ── TIJDLIJN ── */
    .timeline { position: relative; }
    .tl-item { display: flex; gap: 12px; position: relative; }
    .tl-spine { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; width: 18px; margin-top: 18px; }
    .tl-dot {
      width: 16px; height: 16px; border-radius: 50%; flex-shrink: 0;
      border: 2.5px solid #5a3010; background: #3a1800; z-index: 1;
    }
    .tl-dot.visited { background: #5dba7d; border-color: #5dba7d; }
    .tl-dot.current { background: #C8922A; border-color: #C8922A; box-shadow: 0 0 0 5px rgba(200,146,42,0.2); }
    .tl-dot.planned { background: #2a1200; border-color: #5a3010; }
    .tl-line { flex: 1; width: 2px; background: #3a1800; min-height: 20px; margin-top: 3px; }
    .tl-line.visited { background: #5dba7d; }
    .tl-card {
      flex: 1; background: #2a1200; border: 1px solid #5a3010;
      border-radius: 12px; padding: 13px; margin-bottom: 14px;
    }
    .tl-card.current { border-color: #C8922A; border-width: 1.5px; }
    .tl-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 7px; }
    .tl-city { font-size: 15px; font-weight: 700; color: #F5E6C8; }
    .tl-date { font-size: 11px; color: #8a6040; margin-top: 3px; }
    .tl-badge { font-size: 11px; padding: 3px 9px; border-radius: 99px; white-space: nowrap; flex-shrink: 0; }
    .tl-badge.visited { background: #1a4a2a; color: #5dba7d; border: 1px solid #5dba7d; }
    .tl-badge.current { background: #3a2000; color: #C8922A; border: 1px solid #C8922A; }
    .tl-badge.planned { background: #2a1200; color: #5a3010; border: 1px solid #3a1800; }
    .tl-desc { font-size: 13px; color: #d4b896; line-height: 1.55; margin-bottom: 10px; }
    .tl-photo-wrap {
      width: 100%; border-radius: 8px; overflow: hidden;
      aspect-ratio: 16/9; position: relative;
    }
    .tl-photo-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .tl-photo-add {
      width: 100%; border-radius: 8px; background: #1a0a00;
      border: 1.5px dashed #C8922A; aspect-ratio: 16/9;
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: 6px; cursor: pointer;
      color: #C8922A; font-size: 12px; transition: background 0.15s;
    }
    .tl-photo-add:hover { background: #2a1200; }

    /* ── STATUS PICKER ── */
    .status-btns { display: flex; gap: 6px; margin-bottom: 10px; }
    .status-btn {
      flex: 1; padding: 8px 4px; border-radius: 8px; font-size: 11px;
      font-weight: 600; cursor: pointer; text-align: center;
      transition: all 0.15s; border: 1.5px solid;
    }

    /* ── POLLS ── */
    .poll-card { background: #2a1200; border: 1px solid #5a3010; border-radius: 12px; padding: 14px; margin-bottom: 10px; }
    .poll-head { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; }
    .poll-icon-wrap { width: 36px; height: 36px; border-radius: 50%; background: #C8922A; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
    .poll-q { font-size: 14px; font-weight: 600; color: #F5E6C8; line-height: 1.4; padding-top: 7px; }
    .poll-option {
      width: 100%; padding: 11px 14px; text-align: left;
      background: #F5E6C8; border: 2px solid #C8922A;
      border-radius: 8px; font-size: 13px; color: #2a1200; font-weight: 600;
      cursor: pointer; display: flex; justify-content: space-between; align-items: center;
      position: relative; overflow: hidden; margin-bottom: 8px;
      transition: background 0.15s;
    }
    .poll-option:last-child { margin-bottom: 0; }
    .poll-option:hover:not(.voted) { background: #ffffff; }
    .poll-option.selected { border-width: 2.5px; }
    .poll-option.voted { cursor: default; }
    .poll-bar { position: absolute; left: 0; top: 0; bottom: 0; background: rgba(200,146,42,0.18); z-index: 0; transition: width 0.5s; }
    .poll-label { position: relative; z-index: 1; }
    .poll-pct { font-size: 12px; color: #8a6040; position: relative; z-index: 1; font-weight: 500; }
    .poll-pct.winner { color: #8B4513; font-weight: 700; }

    /* ── SCORE ── */
    .score-row { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 0.5px solid #3a1800; }
    .score-row:last-child { border-bottom: none; }
    .score-bar-bg { width: 50px; background: #1a0a00; border-radius: 99px; height: 4px; overflow: hidden; }
    .score-bar-fill { height: 4px; background: #C8922A; border-radius: 99px; }

    /* ── NOTIF LOG ── */
    .notif-row { display: flex; align-items: flex-start; gap: 10px; padding: 10px 0; border-bottom: 0.5px solid #3a1800; }
    .notif-row:last-child { border-bottom: none; }
    .notif-dot { width: 8px; height: 8px; border-radius: 50%; background: #C8922A; margin-top: 4px; flex-shrink: 0; }

    /* ── PUSH BANNER ── */
    #push-banner {
      background: #3a2000; border: 1.5px solid #C8922A;
      border-radius: 12px; padding: 14px; margin-bottom: 12px;
      display: flex; align-items: center; gap: 12px;
    }
    #push-banner span { flex: 1; font-size: 13px; color: #F5E6C8; line-height: 1.4; }
  </style>
</head>
<body>

<!-- ══ ONBOARDING ══ -->
<div id="onboard">
  <div class="ob-hat">🤠</div>
  <div class="ob-title">Howdy Texas!</div>
  <div class="ob-sub" id="ob-sub">
    Volg onze roadtrip live, stem mee en win punten!<br>
    Suis notre roadtrip, vote et gagne des points !
  </div>
  <div class="ob-langs">
    <button class="ob-lang-btn active" id="ob-nl-btn" onclick="obLang('nl',this)">🇧🇪 Nederlands</button>
    <button class="ob-lang-btn" id="ob-fr-btn" onclick="obLang('fr',this)">🇫🇷 Français</button>
  </div>
  <div class="ob-label" id="ob-namelabel">Jouw naam</div>
  <input class="ob-input" id="ob-name" maxlength="20" placeholder="bijv. Sofie..."
    onkeydown="if(event.key==='Enter')completeOnboard()" />
  <button class="ob-btn" id="ob-btn" onclick="completeOnboard()">➜ Laten we gaan!</button>
</div>

<!-- ══ MAIN APP ══ -->
<div id="main-app">

  <div class="topbar">
    <div class="topbar-title">
      <div class="topbar-main">🤠 Howdy Texas!</div>
      <div class="topbar-sub" id="topbar-sub">Live vanuit Texas</div>
    </div>
    <div class="user-pill">👤 <span id="user-name-display">—</span></div>
    <div class="lang-toggle">
      <button class="lang-btn active" id="btn-nl" onclick="setLang('nl')">NL</button>
      <button class="lang-btn" id="btn-fr" onclick="setLang('fr')">FR</button>
    </div>
  </div>

  <div class="tabs">
    <div class="tab active" id="t-reis" onclick="switchTab('reis',this)">
      <div class="tab-icon">🗺️</div>
      <span data-nl="Reis" data-fr="Voyage">Reis</span>
    </div>
    <div class="tab" id="t-polls" onclick="switchTab('polls',this)">
      <div class="tab-icon">📊</div>
      <span data-nl="Stem" data-fr="Vote">Stem</span>
    </div>
    <div class="tab" id="t-score" onclick="switchTab('score',this)">
      <div class="tab-icon">🏆</div>
      <span data-nl="Score" data-fr="Score">Score</span>
    </div>
    <div class="tab" id="t-info" onclick="switchTab('info',this)">
      <div class="tab-icon">🔔</div>
      <span data-nl="Info" data-fr="Info">Info</span>
    </div>
  </div>

  <div class="tab-content">

    <!-- ── REIS TAB ── -->
    <div class="section active" id="section-reis">

      <!-- Nieuwe stop knop -->
      <button class="btn-add" id="add-stop-btn" onclick="showAddStop()">
        ＋ <span data-nl="Nieuwe stop toevoegen" data-fr="Ajouter une étape">Nieuwe stop toevoegen</span>
      </button>

      <!-- Stop formulier -->
      <div class="form-section" id="add-stop-form" style="display:none; margin-top:10px;">
        <div class="fl" data-nl="Stad / naam" data-fr="Ville / nom">Stad / naam</div>
        <input class="wi" id="s-name" placeholder="bijv. San Antonio..." />
        <div class="fl" data-nl="Datum" data-fr="Date">Datum</div>
        <input class="wi" id="s-date" type="date" style="color-scheme:dark;" />
        <div class="fl" data-nl="Beschrijving" data-fr="Description">Beschrijving</div>
        <textarea class="wi" id="s-desc" rows="3" placeholder="Wat hebben we gedaan?"></textarea>
        <div class="fl" data-nl="Foto URL (optioneel)" data-fr="URL photo (optionnel)">Foto URL</div>
        <input class="wi" id="s-photo" placeholder="https://i.imgur.com/..." />
        <div class="fl" data-nl="Status" data-fr="Statut">Status</div>
        <div class="status-btns">
          <button class="status-btn" id="sb-visited" onclick="selStatus('visited',this)"
            style="background:#1a4a2a;border-color:#5dba7d;color:#5dba7d;"
            data-nl="✓ Bezocht" data-fr="✓ Visité">✓ Bezocht</button>
          <button class="status-btn" id="sb-current" onclick="selStatus('current',this)"
            style="background:#3a2200;border-color:#C8922A;color:#C8922A;font-weight:800;"
            data-nl="📍 Nu hier" data-fr="📍 Ici">📍 Nu hier</button>
          <button class="status-btn" id="sb-planned" onclick="selStatus('planned',this)"
            style="background:#1a0a00;border-color:#3a1800;color:#5a3010;"
            data-nl="⏳ Gepland" data-fr="⏳ Prévu">⏳ Gepland</button>
        </div>
        <div class="btn-row">
          <button class="btn-ghost" onclick="hideAddStop()">✕ <span data-nl="Annuleer" data-fr="Annuler">Annuleer</span></button>
          <button class="btn-sm-gold" onclick="submitStop()" style="flex:1;justify-content:center;">
            ➜ <span data-nl="Stop toevoegen" data-fr="Ajouter l'étape">Stop toevoegen</span>
          </button>
        </div>
      </div>

      <!-- Tijdlijn -->
      <div class="timeline" id="timeline" style="margin-top:12px;"></div>

    </div>

    <!-- ── POLLS TAB ── -->
    <div class="section" id="section-polls">
      <div id="polls-container"></div>
      <button class="btn-add" id="new-poll-btn" onclick="showCreatePoll()">
        ＋ <span data-nl="Nieuwe poll aanmaken" data-fr="Créer un sondage">Nieuwe poll aanmaken</span>
      </button>
      <div class="form-section" id="create-poll-form" style="display:none; margin-top:10px;">
        <div class="fl">Vraag NL</div>
        <input class="wi" id="poll-q-nl" placeholder="Vraag in het Nederlands..." />
        <div class="fl">Vraag FR</div>
        <input class="wi" id="poll-q-fr" placeholder="Question en français..." />
        <div class="fl" data-nl="Opties" data-fr="Options">Opties</div>
        <div id="poll-opts-inputs">
          <div class="option-row">
            <input class="wi poll-opt" placeholder="Optie 1..." />
            <button class="remove-opt" onclick="removeOpt(this)">×</button>
          </div>
          <div class="option-row">
            <input class="wi poll-opt" placeholder="Optie 2..." />
            <button class="remove-opt" onclick="removeOpt(this)">×</button>
          </div>
        </div>
        <button class="btn-add" style="margin:8px 0 10px;" onclick="addOptInput()">
          ＋ <span data-nl="Optie toevoegen" data-fr="Ajouter option">Optie toevoegen</span>
        </button>
        <div class="btn-row">
          <button class="btn-ghost" onclick="hideCreatePoll()">✕ <span data-nl="Annuleer" data-fr="Annuler">Annuleer</span></button>
          <button class="btn-sm-gold" onclick="submitPoll()" style="flex:1;justify-content:center;">
            ➜ <span data-nl="Publiceren" data-fr="Publier">Publiceren</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ── SCORE TAB ── -->
    <div class="section" id="section-score">
      <div class="card">
        <div class="card-title">🏆 <span data-nl="Klassement" data-fr="Classement">Klassement</span></div>
        <div id="scoreboard"></div>
      </div>
      <div class="card" style="font-size:12px;color:#8a6040;line-height:1.7;">
        <span data-nl="Elke correcte gok levert 1 punt op. Iedereen die stemt doet automatisch mee."
              data-fr="Chaque bon pronostic rapporte 1 point. Tous les votants participent automatiquement.">
          Elke correcte gok levert 1 punt op.
        </span>
      </div>
    </div>

    <!-- ── INFO TAB ── -->
    <div class="section" id="section-info">

      <!-- Push meldingen -->
      <div id="push-banner">
        <span style="font-size:24px;">🔔</span>
        <span id="push-text" data-nl="Ontvang een melding als er een nieuwe poll of stop toegevoegd wordt!"
              data-fr="Recevez une notification quand un sondage ou étape est ajouté !">
          Ontvang een melding als er een nieuwe poll of stop toegevoegd wordt!
        </span>
        <button class="btn-sm-gold" id="push-btn" onclick="askPushPermission()">
          <span data-nl="Inschrijven" data-fr="S'abonner">Inschrijven</span>
        </button>
      </div>

      <!-- Link delen -->
      <div class="card" style="text-align:center;">
        <div class="card-title" style="justify-content:center;">🔗 <span data-nl="Stuur de link" data-fr="Envoyez le lien">Stuur de link</span></div>
        <div style="font-size:13px;color:#8a6040;margin-bottom:10px;"
             data-nl="Ze kiezen zelf hun naam bij het openen"
             data-fr="Ils choisissent leur prénom à l'ouverture">
          Ze kiezen zelf hun naam bij het openen
        </div>
        <div style="background:#1a0a00;border:1px solid #3a1800;border-radius:8px;padding:9px 12px;display:flex;align-items:center;justify-content:space-between;gap:8px;">
          <span id="share-url" style="font-size:12px;color:#8a6040;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
            <!-- filled by JS -->
          </span>
          <button class="btn-sm-gold" onclick="copyLink(this)">
            📋 <span data-nl="Kopieer" data-fr="Copier">Kopieer</span>
          </button>
        </div>
        <button class="btn-add" style="margin-top:10px;" onclick="shareApp()">
          ↗ <span data-nl="Deel via WhatsApp / iMessage" data-fr="Partager via WhatsApp / iMessage">Deel via WhatsApp / iMessage</span>
        </button>
      </div>

      <!-- App installeren -->
      <div class="card" style="font-size:12px;color:#8a6040;line-height:1.8;">
        <div class="card-title">📱 <span data-nl="Als app installeren" data-fr="Installer comme appli">Als app installeren</span></div>
        <span data-nl="Android: browsermenu → 'Toevoegen aan startscherm' • iPhone: Safari → Deel → 'Zet op beginscherm'"
              data-fr="Android: menu → 'Ajouter à l'écran d'accueil' • iPhone: Safari → Partager → 'Sur l'écran d'accueil'">
          Android: browsermenu → 'Toevoegen aan startscherm' • iPhone: Safari → Deel → 'Zet op beginscherm'
        </span>
      </div>

      <!-- Activiteiten log -->
      <div class="card">
        <div class="card-title"><span class="badge-live">Live</span> &nbsp;<span data-nl="Activiteiten log" data-fr="Journal d'activité">Activiteiten log</span></div>
        <div id="notif-log">
          <div class="notif-row">
            <div class="notif-dot"></div>
            <div>
              <div style="font-size:13px;color:#d4b896;" data-nl="App gelanceerd! 🎉" data-fr="Application lancée ! 🎉">App gelanceerd! 🎉</div>
              <div style="font-size:11px;color:#5a3010;margin-top:2px;">nu</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /tab-content -->
</div><!-- /main-app -->

<script>
// ══════════════════════════════════════
//  STATE
// ══════════════════════════════════════
let lang = localStorage.getItem('ht-lang') || 'nl';
let userName = localStorage.getItem('ht-user') || '';

const state = JSON.parse(localStorage.getItem('ht-state') || 'null') || {
  stops: [
    { name_nl:'Austin', name_fr:'Austin', date:'2024-08-12',
      desc_nl:'Aangekomen! Eerste cowboyhoed gekocht op South Congress.',
      desc_fr:'Arrivés ! Premier chapeau de cowboy acheté sur South Congress.',
      photo:'', status:'current' },
    { name_nl:'San Antonio', name_fr:'San Antonio', date:'2024-08-14',
      desc_nl:'The Alamo en de River Walk — prachtig!',
      desc_fr:'The Alamo et la River Walk — magnifique !',
      photo:'', status:'planned' },
    { name_nl:'Houston', name_fr:'Houston', date:'2024-08-16',
      desc_nl:'Space Center & rodeo',
      desc_fr:'Space Center & rodéo',
      photo:'', status:'planned' },
    { name_nl:'Dallas', name_fr:'Dallas', date:'2024-08-18',
      desc_nl:'Eindbestemming — Cowboys Stadium en Deep Ellum.',
      desc_fr:'Destination finale — Cowboys Stadium et Deep Ellum.',
      photo:'', status:'planned' }
  ],
  polls: [
    { id:1, icon:'🍽️',
      q_nl:'Waar gaan we vanavond eten?', q_fr:'Où mange-t-on ce soir ?',
      options:['Franklin Barbecue',"Stubb's BBQ",'La Condesa'],
      votes:[4,7,2], voted:false, winner:null },
    { id:2, icon:'🐴',
      q_nl:'Wie wint de rodeo?', q_fr:'Qui gagne le rodéo ?',
      options:['Buck Williams','Jesse Ray','Dusty Torres'],
      votes:[3,5,3], voted:false, winner:null }
  ],
  players: {}
};

function saveState() {
  localStorage.setItem('ht-state', JSON.stringify(state));
}

// ══════════════════════════════════════
//  ONBOARDING
// ══════════════════════════════════════
function obLang(l, btn) {
  lang = l;
  localStorage.setItem('ht-lang', l);
  document.getElementById('ob-nl-btn').className = 'ob-lang-btn' + (l==='nl' ? ' active' : '');
  document.getElementById('ob-fr-btn').className = 'ob-lang-btn' + (l==='fr' ? ' active' : '');
  document.getElementById('ob-sub').innerHTML = l === 'fr'
    ? 'Suis notre roadtrip, vote et gagne des points !<br>Volg onze roadtrip live, stem mee en win punten!'
    : 'Volg onze roadtrip live, stem mee en win punten!<br>Suis notre roadtrip, vote et gagne des points !';
  document.getElementById('ob-namelabel').textContent = l === 'fr' ? 'Ton prénom' : 'Jouw naam';
  document.getElementById('ob-name').placeholder = l === 'fr' ? 'ex. Sophie...' : 'bijv. Sofie...';
  document.getElementById('ob-btn').textContent = l === 'fr' ? '➜ C\'est parti !' : '➜ Laten we gaan!';
}

function completeOnboard() {
  const n = document.getElementById('ob-name').value.trim();
  if (!n) { document.getElementById('ob-name').focus(); return; }
  userName = n;
  localStorage.setItem('ht-user', n);
  if (!state.players[n]) state.players[n] = 0;
  saveState();
  document.getElementById('onboard').style.display = 'none';
  document.getElementById('main-app').style.display = 'flex';
  document.getElementById('user-name-display').textContent = n;
  applyLang();
  renderTimeline();
  renderPolls();
  renderScore();
  document.getElementById('share-url').textContent = window.location.href;
}

// Skip onboarding if already registered
window.addEventListener('load', () => {
  if (userName) {
    obLang(lang, document.getElementById('ob-' + lang + '-btn'));
    document.getElementById('ob-name').value = userName;
    completeOnboard();
  } else {
    obLang(lang, document.getElementById('ob-' + lang + '-btn'));
  }
  registerSW();
});

// ══════════════════════════════════════
//  LANGUAGE
// ══════════════════════════════════════
function setLang(l) {
  lang = l;
  localStorage.setItem('ht-lang', l);
  document.getElementById('btn-nl').className = 'lang-btn' + (l==='nl' ? ' active' : '');
  document.getElementById('btn-fr').className = 'lang-btn' + (l==='fr' ? ' active' : '');
  applyLang();
  renderTimeline();
  renderPolls();
  renderScore();
}

function applyLang() {
  document.querySelectorAll('[data-nl]').forEach(el => {
    const t = el.getAttribute('data-' + lang);
    if (t) el.textContent = t;
  });
  document.getElementById('topbar-sub').textContent = lang === 'fr' ? 'En direct du Texas' : 'Live vanuit Texas';
}

// ══════════════════════════════════════
//  TABS
// ══════════════════════════════════════
function switchTab(name, el) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.getElementById('section-' + name).classList.add('active');
  el.classList.add('active');
  if (name === 'polls') renderPolls();
  if (name === 'score') renderScore();
}

// ══════════════════════════════════════
//  TIJDLIJN
// ══════════════════════════════════════
let newStopStatus = 'current';

function selStatus(s) {
  newStopStatus = s;
  const cfg = {
    visited: { bg:'#1a4a2a', bc:'#5dba7d', c:'#5dba7d' },
    current: { bg:'#3a2200', bc:'#C8922A', c:'#C8922A' },
    planned: { bg:'#1a0a00', bc:'#3a1800', c:'#5a3010' }
  };
  ['visited','current','planned'].forEach(st => {
    const b = document.getElementById('sb-' + st);
    const active = st === s;
    b.style.background = active ? cfg[st].bg : '#1a0a00';
    b.style.borderColor = active ? cfg[st].bc : '#3a1800';
    b.style.color = active ? cfg[st].c : '#5a3010';
    b.style.fontWeight = active ? '800' : '400';
  });
}

function showAddStop() {
  document.getElementById('add-stop-form').style.display = 'block';
  document.getElementById('add-stop-btn').style.display = 'none';
  document.getElementById('s-date').value = new Date().toISOString().split('T')[0];
  selStatus('current');
}
function hideAddStop() {
  document.getElementById('add-stop-form').style.display = 'none';
  document.getElementById('add-stop-btn').style.display = 'flex';
}

function submitStop() {
  const name = document.getElementById('s-name').value.trim();
  const date = document.getElementById('s-date').value;
  const desc = document.getElementById('s-desc').value.trim();
  const photo = document.getElementById('s-photo').value.trim();
  if (!name) return;
  state.stops.push({ name_nl:name, name_fr:name, date, desc_nl:desc, desc_fr:desc, photo, status:newStopStatus });
  saveState();
  ['s-name','s-desc','s-photo'].forEach(id => document.getElementById(id).value = '');
  hideAddStop();
  addNotif(lang === 'fr' ? `Nouvelle étape: ${name}` : `Nieuwe stop: ${name}`);
  sendPushToAll(
    lang === 'fr' ? '📍 Nouvelle étape!' : '📍 Nieuwe stop!',
    lang === 'fr' ? `${name} ajouté à l'itinéraire` : `${name} toegevoegd aan de route`
  );
  renderTimeline();
}

function addPhotoToStop(idx) {
  const url = prompt(lang === 'fr' ? 'Collez une URL de photo:' : 'Plak een foto-URL:');
  if (!url) return;
  state.stops[idx].photo = url;
  saveState();
  renderTimeline();
}

function renderTimeline() {
  const c = document.getElementById('timeline');
  const order = { current:0, visited:1, planned:2 };
  const sorted = [...state.stops].sort((a, b) => {
    if (order[a.status] !== order[b.status]) return order[a.status] - order[b.status];
    return new Date(b.date) - new Date(a.date);
  });

  const statusLabel = {
    visited: { nl:'Bezocht ✓', fr:'Visité ✓' },
    current: { nl:'Nu hier 📍', fr:'Ici 📍' },
    planned: { nl:'Gepland', fr:'Prévu' }
  };

  let html = '';
  sorted.forEach((s, i) => {
    const isLast = i === sorted.length - 1;
    const realIdx = state.stops.indexOf(s);
    const name = lang === 'fr' ? s.name_fr : s.name_nl;
    const desc = lang === 'fr' ? s.desc_fr : s.desc_nl;
    const dateStr = s.date
      ? new Date(s.date + 'T12:00:00').toLocaleDateString(lang === 'fr' ? 'fr-BE' : 'nl-BE', { day:'numeric', month:'long', year:'numeric' })
      : '';

    html += `<div class="tl-item">
      <div class="tl-spine">
        <div class="tl-dot ${s.status}"></div>
        ${!isLast ? `<div class="tl-line ${s.status==='visited'?'visited':''}"></div>` : ''}
      </div>
      <div class="tl-card ${s.status}">
        <div class="tl-head">
          <div>
            <div class="tl-city">${name}</div>
            ${dateStr ? `<div class="tl-date">📅 ${dateStr}</div>` : ''}
          </div>
          <span class="tl-badge ${s.status}">${statusLabel[s.status][lang]}</span>
        </div>
        ${desc ? `<div class="tl-desc">${desc}</div>` : ''}
        ${s.photo
          ? `<div class="tl-photo-wrap"><img src="${s.photo}" alt="foto" loading="lazy" /></div>`
          : s.status !== 'planned'
            ? `<div class="tl-photo-add" onclick="addPhotoToStop(${realIdx})"><span style="font-size:22px;">📷</span><span>${lang==='fr'?'Ajouter une photo':'Foto toevoegen'}</span></div>`
            : ''
        }
      </div>
    </div>`;
  });
  c.innerHTML = html;
}

// ══════════════════════════════════════
//  POLLS
// ══════════════════════════════════════
function renderPolls() {
  const c = document.getElementById('polls-container');
  c.innerHTML = '';
  state.polls.forEach(poll => {
    const total = poll.votes.reduce((a, b) => a + b, 0);
    const maxV = Math.max(...poll.votes);
    const q = lang === 'fr' ? poll.q_fr : poll.q_nl;
    const div = document.createElement('div');
    div.className = 'poll-card';
    const opts = poll.options.map((opt, i) => {
      const pct = total > 0 ? Math.round(poll.votes[i] / total * 100) : 0;
      const isW = poll.voted && poll.votes[i] === maxV;
      return `<button class="poll-option ${poll.voted?'voted':''} ${poll.winner===i?'selected':''}"
        ${poll.voted ? '' : `onclick="vote(${poll.id},${i})"`}>
        <div class="poll-bar" style="width:${poll.voted?pct:0}%"></div>
        <span class="poll-label">${opt}</span>
        <span class="poll-pct ${isW?'winner':''}">${poll.voted ? (isW?'🏆 ':'')+pct+'%' : ''}</span>
      </button>`;
    }).join('');
    div.innerHTML = `
      <div class="poll-head">
        <div class="poll-icon-wrap">${poll.icon}</div>
        <div class="poll-q">${q}</div>
      </div>
      ${opts}`;
    c.appendChild(div);
  });
}

function vote(pollId, optIdx) {
  const poll = state.polls.find(p => p.id === pollId);
  if (!poll || poll.voted) return;
  poll.votes[optIdx]++;
  poll.voted = true;
  poll.winner = optIdx;
  if (userName) state.players[userName] = (state.players[userName] || 0) + (Math.random() < 0.5 ? 1 : 0);
  saveState();
  renderPolls();
  renderScore();
}

function showCreatePoll() {
  document.getElementById('create-poll-form').style.display = 'block';
  document.getElementById('new-poll-btn').style.display = 'none';
}
function hideCreatePoll() {
  document.getElementById('create-poll-form').style.display = 'none';
  document.getElementById('new-poll-btn').style.display = 'flex';
}
function addOptInput() {
  const c = document.getElementById('poll-opts-inputs');
  const d = document.createElement('div');
  d.className = 'option-row';
  d.innerHTML = `<input class="wi poll-opt" placeholder="Optie ${c.children.length+1}..." /><button class="remove-opt" onclick="removeOpt(this)">×</button>`;
  c.appendChild(d);
}
function removeOpt(btn) {
  if (document.querySelectorAll('.poll-opt').length > 2) btn.closest('.option-row').remove();
}
function submitPoll() {
  const qNl = document.getElementById('poll-q-nl').value.trim();
  const qFr = document.getElementById('poll-q-fr').value.trim();
  const opts = [...document.querySelectorAll('.poll-opt')].map(i => i.value.trim()).filter(Boolean);
  if (!qNl || opts.length < 2) return;
  const icons = ['⭐','📍','🤠','🎵','📷','🔥','🌮','🐴'];
  state.polls.push({
    id: Date.now(), icon: icons[Math.floor(Math.random()*icons.length)],
    q_nl: qNl, q_fr: qFr || qNl,
    options: opts, votes: opts.map(() => 0), voted: false, winner: null
  });
  saveState();
  addNotif(lang === 'fr' ? `Nouveau sondage: ${qFr||qNl}` : `Nieuwe poll: ${qNl}`);
  sendPushToAll(
    lang === 'fr' ? '📊 Nouveau sondage!' : '📊 Nieuwe poll!',
    lang === 'fr' ? qFr || qNl : qNl
  );
  document.getElementById('poll-q-nl').value = '';
  document.getElementById('poll-q-fr').value = '';
  document.querySelectorAll('.poll-opt').forEach(i => i.value = '');
  hideCreatePoll();
  renderPolls();
}

// ══════════════════════════════════════
//  SCORE
// ══════════════════════════════════════
function renderScore() {
  const players = Object.entries(state.players).sort((a, b) => b[1] - a[1]);
  const max = players[0]?.[1] || 1;
  const medals = ['🥇','🥈','🥉'];
  document.getElementById('scoreboard').innerHTML = players.length
    ? players.map(([name, pts], i) => `
        <div class="score-row">
          <div style="font-size:16px;width:28px;text-align:center;">${medals[i]||''}</div>
          <div style="flex:1;font-size:14px;color:#F5E6C8;">${name}${name===userName?' 👈':''}</div>
          <div class="score-bar-bg"><div class="score-bar-fill" style="width:${Math.round(pts/max*100)}%"></div></div>
          <div style="font-size:13px;font-weight:600;color:#C8922A;">${pts} pt</div>
        </div>`).join('')
    : `<div style="font-size:13px;color:#5a3010;padding:8px 0;">${lang==='fr'?'Personne n\'a encore voté.':'Nog niemand gestemd.'}</div>`;
}

// ══════════════════════════════════════
//  NOTIF LOG
// ══════════════════════════════════════
function addNotif(text) {
  const log = document.getElementById('notif-log');
  const d = document.createElement('div');
  d.className = 'notif-row';
  d.innerHTML = `<div class="notif-dot"></div><div><div style="font-size:13px;color:#d4b896;">${text}</div><div style="font-size:11px;color:#5a3010;margin-top:2px;">${new Date().toLocaleTimeString(lang==='fr'?'fr-BE':'nl-BE',{hour:'2-digit',minute:'2-digit'})}</div></div>`;
  log.prepend(d);
}

// ══════════════════════════════════════
//  DELEN
// ══════════════════════════════════════
function copyLink(btn) {
  navigator.clipboard.writeText(window.location.href).catch(() => {});
  const orig = btn.innerHTML;
  btn.innerHTML = lang === 'fr' ? '✓ Copié !' : '✓ Gekopieerd!';
  setTimeout(() => btn.innerHTML = orig, 2000);
}

function shareApp() {
  const url = window.location.href;
  const text = lang === 'fr'
    ? `🤠 Suis notre roadtrip au Texas en live ! Vote pour nos activités et gagne des points !\n${url}`
    : `🤠 Volg onze Texas roadtrip live! Stem mee en win punten!\n${url}`;
  if (navigator.share) {
    navigator.share({ title: 'Howdy Texas!', text, url });
  } else {
    window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
  }
}

// ══════════════════════════════════════
//  SERVICE WORKER + PUSH
// ══════════════════════════════════════
let swReg = null;

async function registerSW() {
  if ('serviceWorker' in navigator) {
    try {
      swReg = await navigator.serviceWorker.register('/sw.js');
      console.log('SW registered');
      checkPushStatus();
    } catch(e) {
      console.log('SW registration failed:', e);
    }
  }
}

function checkPushStatus() {
  if (!('Notification' in window)) {
    document.getElementById('push-banner').style.display = 'none';
    return;
  }
  if (Notification.permission === 'granted') {
    document.getElementById('push-banner').innerHTML =
      `<span style="font-size:20px;">✅</span><span style="flex:1;font-size:13px;color:#5dba7d;">${lang==='fr'?'Vous recevrez des notifications !':'Je ontvangt meldingen!'}</span>`;
  }
}

async function askPushPermission() {
  if (!('Notification' in window)) {
    alert(lang === 'fr' ? 'Notifications non supportées sur ce navigateur.' : 'Pushmeldingen worden niet ondersteund op deze browser.');
    return;
  }
  const permission = await Notification.requestPermission();
  if (permission === 'granted') {
    checkPushStatus();
    // Sla subscription op in localStorage (voor demo zonder server)
    localStorage.setItem('ht-push', 'granted');
    // Stuur een welkomstmelding
    if (swReg) {
      swReg.showNotification('🤠 Howdy Texas!', {
        body: lang === 'fr' ? 'Vous recevrez des alertes pour les nouvelles étapes et sondages !' : 'Je krijgt meldingen bij nieuwe stops en polls!',
        icon: '/icon-192.png',
        badge: '/icon-192.png',
        vibrate: [200, 100, 200]
      });
    }
  }
}

function sendPushToAll(title, body) {
  // Lokale push (zelfde toestel) via service worker
  if (swReg && Notification.permission === 'granted') {
    swReg.showNotification(title, {
      body,
      icon: '/icon-192.png',
      badge: '/icon-192.png',
      vibrate: [200, 100, 200],
      tag: 'howdy-texas-' + Date.now()
    });
  }
}
</script>
</body>
</html>
